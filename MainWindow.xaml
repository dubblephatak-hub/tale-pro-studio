<Window x:Class="TalePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tale-Pro Video Processing Studio" Height="800" Width="1400"
        WindowStyle="None" AllowsTransparency="True" Background="#0B101B"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="WindowBtnStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8A95A5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="45"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A2235"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton"><Setter Property="Height" Value="45"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8A95A5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="12,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border Background="{TemplateBinding Background}" CornerRadius="8"><StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="{TemplateBinding Content}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#121828"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#113668"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="OutlineBtnStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8A95A5"/><Setter Property="BorderBrush" Value="#2A354D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A2235"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4A5A7D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryBtnStyle" TargetType="Button"><Setter Property="Background" Value="#2F80ED"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#113668"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="IconBtnStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8A95A5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#331820"/><Setter Property="Foreground" Value="#E81123"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="CustomSliderStyle" TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="6" Background="#2A354D" CornerRadius="3" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="#2F80ED" CornerRadius="3,0,0,3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="16" Height="16" Fill="#2F80ED" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="border" Width="40" Height="20" CornerRadius="10" Background="#2A354D" Cursor="Hand"><Ellipse x:Name="ellipse" Width="14" Height="14" Fill="#8A95A5" HorizontalAlignment="Left" Margin="3,0,0,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="border" Property="Background" Value="#2F80ED"/><Setter TargetName="ellipse" Property="Fill" Value="#FFFFFF"/><Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="ellipse" Property="Margin" Value="0,0,3,0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#0F172A"/><Setter Property="BorderBrush" Value="#1E293B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="34"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6"><TextBlock Text="▼" Foreground="#94A3B8" FontSize="10" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F8FAFC"/></Style></ContentPresenter.Resources></ContentPresenter><Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"><Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"><ScrollViewer MaxHeight="200"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#1E3A8A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Border" Property="Background" Value="#1E3A8A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar"><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="true"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#1E293B" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid x:Name="AppWrapper">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#080C15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Background="#2F80ED" Width="24" Height="24" CornerRadius="4"><TextBlock Text="T" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/></Border>
                        <TextBlock Text="TALE-PRO" Foreground="White" FontWeight="Bold" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VIDEO PROCESSING STUDIO" Foreground="#5A6679" FontWeight="SemiBold" FontSize="11" Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⚙" Style="{StaticResource WindowBtnStyle}" Click="NavSettings_Click" FontSize="16" Margin="0,0,10,0"/>
                        <Button Content="—" Style="{StaticResource WindowBtnStyle}" Click="Minimize_Click"/>
                        <Button Content="☐" Style="{StaticResource WindowBtnStyle}" Click="Maximize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowBtnStyle}" Click="Close_Click"><Button.Resources><Style TargetType="Button" BasedOn="{StaticResource WindowBtnStyle}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123"/></Trigger></Style.Triggers></Style></Button.Resources></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="#080C15" BorderBrush="#1A2235" BorderThickness="0,1,1,0">
                <Grid>
                    <StackPanel Margin="0,15,0,0">
                        <RadioButton x:Name="TabHome" Content="Home" IsChecked="True" Style="{StaticResource NavButtonStyle}" Tag="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" Click="NavTab_Click"/>
                        <RadioButton x:Name="TabProcess" Content="Process" Style="{StaticResource NavButtonStyle}" Tag="M8,5.14V19.14L19,12.14L8,5.14Z" Click="NavTab_Click"/>
                        <RadioButton x:Name="TabCompare" Content="Compare" Style="{StaticResource NavButtonStyle}" Tag="M18,3H6C4.89,3 4,3.89 4,5V19C4,20.1 4.89,21 6,21H18C19.1,21 20,20.1 20,19V5C20,3.89 19.1,3 18,3M10,19H6V5H10V19M18,19H14V5H18V19M12,11V13H12V11Z" Click="NavTab_Click"/>
                        <RadioButton x:Name="TabSettings" Content="Settings" Style="{StaticResource NavButtonStyle}" Tag="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Click="NavTab_Click"/>
                        <RadioButton x:Name="TabAbout" Content="About" Style="{StaticResource NavButtonStyle}" Tag="M11,18H13V10H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z" Click="NavTab_Click"/>
                    </StackPanel>
                    <Border VerticalAlignment="Bottom" Margin="15,0,15,20" Background="#0C1425" BorderBrush="#1A2844" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,2V13H10V22L17,10H13L17,2H7Z" Fill="#2F80ED" Width="14" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Hardware Accelerated" Foreground="#D1D5DB" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NavHwStatusTxt" Text="Universal GPU Engine" Foreground="#8A95A5" FontSize="9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#0B101B" BorderBrush="#1A2235" BorderThickness="0,1,0,0">
                <Grid>
                    <!-- 1. HOME VIEW -->
                    <Grid x:Name="ViewHome" Visibility="Visible">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <Border x:Name="EmptyStateBorder" Height="140" Background="#0C1425" CornerRadius="10" AllowDrop="True" Drop="Grid_Drop" MouseLeftButtonDown="SelectVideo_Click" Cursor="Hand" Visibility="Visible">
                                    <Grid>
                                        <Rectangle Stroke="#2A354D" StrokeThickness="2" StrokeDashArray="4 4" RadiusX="10" RadiusY="10" Margin="2"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z" Fill="#5A6679" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Click to Select Video or Drag &amp; Drop" Foreground="#8A95A5" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="LoadedStatePanel" Visibility="Collapsed">
                                    <Border Background="#0C1425" BorderBrush="#151E32" BorderThickness="1" CornerRadius="10" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="160" Height="90">
                                                <Border CornerRadius="6" Background="#05080E" ClipToBounds="True"><Image x:Name="ThumbImage" Stretch="UniformToFill"/></Border>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Background="#E6000000" CornerRadius="4" Padding="6,2"><TextBlock x:Name="ThumbResBadge" Text="4K" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="20,5,0,0" VerticalAlignment="Top">
                                                <TextBlock x:Name="VidTitle" Text="Loading..." Foreground="#E2E8F0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"><Path Data="M21,16H3V8H21M21,6H3C1.89,6 1,6.89 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8C23,6.89 22.1,6 21,6Z" Fill="#5A6679" Width="14" Height="14" Stretch="Uniform"/><TextBlock x:Name="VidResolution" Text="-" Foreground="#8A95A5" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"><Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,6V12L16.25,14.5L17,13.25L13.5,11.25V6H12Z" Fill="#5A6679" Width="14" Height="14" Stretch="Uniform"/><TextBlock x:Name="VidFPS" Text="-" Foreground="#8A95A5" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"><Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" Fill="#5A6679" Width="14" Height="14" Stretch="Uniform"/><TextBlock x:Name="VidDuration" Text="-" Foreground="#8A95A5" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"><Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Fill="#5A6679" Width="14" Height="14" Stretch="Uniform"/><TextBlock x:Name="VidSize" Text="-" Foreground="#8A95A5" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"><Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Fill="#5A6679" Width="14" Height="14" Stretch="Uniform"/><TextBlock x:Name="VidCodec" Text="-" Foreground="#8A95A5" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <Button Style="{StaticResource OutlineBtnStyle}" Click="ChangeFile_Click"><StackPanel Orientation="Horizontal"><Path Data="M21,19V5C21,3.89 20.1,3 19,3H14.71L12.71,5H5C3.89,5 3,5.89 3,7V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M5,19V7H19V19H5M12.5,10V12H9.5V14H12.5V16L15.5,13L12.5,10Z" Fill="#8A95A5" Width="14" Height="14" Stretch="Uniform"/><TextBlock Text="Change File" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"/></StackPanel></Button>
                                                <Button Style="{StaticResource IconBtnStyle}" Click="Trash_Click" Margin="10,0,0,0" Tag="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Process Settings Card -->
                                    <Border Background="#0C1425" BorderBrush="#151E32" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="10*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="9*"/><ColumnDefinition Width="10*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="PROCESS SETTINGS" Foreground="#5A6679" FontSize="11" FontWeight="Bold" Margin="0,0,0,20"/>
                                                <TextBlock Text="Quality / Size Level" Foreground="#8A95A5" FontSize="12" Margin="0,0,0,15"/>
                                                <Slider x:Name="QualitySlider" Minimum="1" Maximum="10" Value="6" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource CustomSliderStyle}" ValueChanged="Config_ValueChanged"/>
                                                <UniformGrid Columns="10" Margin="0,8,0,0">
                                                    <TextBlock Text="1" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="2" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="3" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="4" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="5" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="6" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="7" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="8" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="9" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="10" Foreground="#5A6679" FontSize="11" HorizontalAlignment="Center"/>
                                                </UniformGrid>
                                            </StackPanel>
                                            <Rectangle Grid.Column="1" Width="1" Fill="#1A2235" Margin="10,0"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                                                <TextBlock Text="Estimated Output Size" Foreground="#8A95A5" FontSize="12" Margin="0,0,0,10"/>
                                                <WrapPanel Margin="0,0,0,20" VerticalAlignment="Center">
                                                    <TextBlock x:Name="EstSizeTxt" Text="~ 0 MB" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                                    <Border x:Name="EstBadgeBorder" Background="#064E3B" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="EstBadgeTxt" Text="0% smaller" Foreground="#10B981" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="Estimated Time" Foreground="#8A95A5" FontSize="12" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="EstTimeTxt" Text="⏱ ~ 0s" Foreground="#D1D5DB" FontSize="14" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                                    <TextBlock Text="Encoding Preset" Foreground="#8A95A5" FontSize="11" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="PresetCombo" Style="{StaticResource DarkComboBox}" SelectedIndex="0" SelectionChanged="Config_SelectionChanged"><ComboBoxItem Content="Tale-Pro (Recommended)"/><ComboBoxItem Content="Ultra Fast NVENC"/><ComboBoxItem Content="x264 Studio Master"/></ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                                    <TextBlock Text="Codec" Foreground="#8A95A5" FontSize="11" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="CodecCombo" Style="{StaticResource DarkComboBox}" SelectedIndex="0" SelectionChanged="Config_SelectionChanged"><ComboBoxItem Content="H.264 (MP4)"/><ComboBoxItem Content="HEVC / H.265 (MP4)"/></ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <TextBlock Text="Hardware Acceleration" Foreground="#8A95A5" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <CheckBox x:Name="HwAccelToggle" IsChecked="True" Style="{StaticResource ToggleSwitchStyle}" Click="Config_Click"/>
                                                </StackPanel>
