                        <Slider x:Name="WipeSlider" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="50" ValueChanged="WipeSlider_ValueChanged" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0.8" Visibility="Collapsed">
                            <Slider.Template><ControlTemplate TargetType="Slider">
                                <Grid><Track x:Name="PART_Track"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="24" Height="24" Background="#111827" BorderBrush="#2F80ED" BorderThickness="2" CornerRadius="12" Cursor="SizeWE"><TextBlock Text="↔" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track><Rectangle Fill="White" Width="2" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="{Binding Margin, ElementName=PART_Track.Thumb}"/></Grid>
                            </ControlTemplate></Slider.Template>
                        </Slider>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="▶" Style="{StaticResource WindowBtnStyle}" Width="30" FontSize="16" Click="PlayPause_Click" x:Name="BtnPlayPause"/>
                    <Button Grid.Column="1" Content="🔊" Style="{StaticResource WindowBtnStyle}" Width="30" FontSize="14" Click="Mute_Click" x:Name="BtnMute"/>
                    <Slider Grid.Column="2" x:Name="TimeScrubber" Minimum="0" Maximum="5" Value="0" Style="{StaticResource CustomSliderStyle}" Margin="15,0" VerticalAlignment="Center" ValueChanged="TimeScrubber_ValueChanged"/>
                    <TextBlock Grid.Column="3" x:Name="TimeCodeTxt" Text="00:00.00 / 00:00.00" Foreground="#8A95A5" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>


